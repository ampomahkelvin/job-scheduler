# Server
PORT=3000
LOG_LEVEL=info

# Redis
REDIS_URL=redis://localhost:6379

# Optional: Bull Board
BULL_BOARD_PATH=/admin/queues

# Optional: API Key for authentication (comma-separated for multiple keys)
API_KEY=your-secret-api-key-here

# Optional: Rate limit for webhook handler (requests per second)
RATE_LIMIT_WEBHOOK=10